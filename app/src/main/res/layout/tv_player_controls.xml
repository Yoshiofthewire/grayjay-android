<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/tv_player_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_overscan_h"
        android:paddingTop="96dp"
        android:paddingEnd="@dimen/tv_overscan_h"
        android:paddingBottom="@dimen/tv_overscan_v">

        <TextView
            android:id="@+id/tv_controls_title"
            style="@style/TvText.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:maxWidth="720dp"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_controls_meta"
            style="@style/TvText.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="18dp"
            android:focusable="true"
            app:bar_height="4dp"
            app:buffered_color="#66FFFFFF"
            app:played_color="@color/colorPrimary"
            app:scrubber_color="@color/white"
            app:scrubber_dragged_size="22dp"
            app:scrubber_enabled_size="16dp"
            app:unplayed_color="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                style="@style/TvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textSize="14sp" />

            <TextView
                style="@style/TvText.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  /  "
                android:textSize="14sp" />

            <TextView
                android:id="@+id/exo_duration"
                style="@style/TvText.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tv_button"
                android:contentDescription="@string/tv_rewind"
                android:scaleType="centerInside"
                android:src="@drawable/ic_fast_rewind"
                android:tint="@color/tv_button_text" />

            <ImageButton
                android:id="@+id/exo_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/tv_button"
                android:contentDescription="@string/tv_play_pause"
                android:scaleType="centerInside"
                android:tint="@color/tv_button_text" />

            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tv_button"
                android:contentDescription="@string/tv_forward"
                android:scaleType="centerInside"
                android:src="@drawable/ic_fast_forward"
                android:tint="@color/tv_button_text" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
