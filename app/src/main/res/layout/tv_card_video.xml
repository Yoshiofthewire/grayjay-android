<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tv_card"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/card_frame"
        android:layout_width="match_parent"
        android:layout_height="126dp"
        android:duplicateParentState="true"
        android:foreground="@drawable/tv_card_frame"
        android:padding="5dp">

        <!-- The focus ring draws in the 5dp padding, outside the thumbnail, so it reads on light images. -->
        <ImageView
            android:id="@+id/card_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tv_thumb_bg"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="13dp"
            android:background="@drawable/tv_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/card_badge_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/card_badge_text"
                style="@style/TvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:singleLine="true"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_duration"
            style="@style/TvText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="13dp"
            android:background="@drawable/tv_chip"
            android:fontFamily="@font/inter_semibold"
            android:fontFeatureSettings="tnum"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textSize="12sp" />

        <View
            android:id="@+id/card_new"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:layout_margin="13dp"
            android:background="@drawable/tv_new_dot"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/card_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:max="1000"
            android:progressDrawable="@drawable/tv_progress"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/card_title"
        style="@style/TvText.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:duplicateParentState="true"
        android:textColor="@color/tv_card_title" />

    <TextView
        android:id="@+id/card_meta"
        style="@style/TvText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp" />
</LinearLayout>
