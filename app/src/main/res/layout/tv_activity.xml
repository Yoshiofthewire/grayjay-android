<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <FrameLayout
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/tv_rail_width" />

    <View
        android:id="@+id/tv_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#B3000000" />

    <LinearLayout
        android:id="@+id/tv_rail"
        android:layout_width="@dimen/tv_rail_width"
        android:layout_height="match_parent"
        android:background="@color/tv_rail"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="@dimen/tv_overscan_v"
        android:paddingEnd="12dp"
        android:paddingBottom="@dimen/tv_overscan_v">

        <ImageView
            android:id="@+id/tv_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:contentDescription="@null"
            android:src="@drawable/foreground" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_toast"
        style="@style/TvText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/tv_panel"
        android:elevation="8dp"
        android:fontFamily="@font/inter_semibold"
        android:maxWidth="560dp"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
