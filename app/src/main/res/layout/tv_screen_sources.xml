<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_overscan_h"
    android:paddingTop="@dimen/tv_overscan_v"
    android:paddingEnd="@dimen/tv_overscan_h"
    android:paddingBottom="@dimen/tv_overscan_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="@null"
            android:src="@drawable/foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TvText.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_sources_title" />

            <TextView
                style="@style/TvText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tv_sources_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/sources_skip"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/sources_add"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/tv_button_primary"
            android:minWidth="180dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/sources_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:focusOutFront="true"
            app:focusOutSideStart="true"
            app:focusOutSideEnd="true" />

        <TextView
            android:id="@+id/sources_status"
            style="@style/TvText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxWidth="480dp" />
    </FrameLayout>
</LinearLayout>
