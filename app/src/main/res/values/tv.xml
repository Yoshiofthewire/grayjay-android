<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="tv_rail">#0D0D0D</color>
    <color name="tv_surface">#161616</color>
    <color name="tv_surface_2">#232323</color>
    <color name="tv_muted">#ACACAC</color>
    <color name="tv_dim">#8C8C8C</color>
    <color name="tv_live">#E53935</color>
    <color name="tv_warn">#E5554F</color>

    <!-- 1080p TV at xhdpi is 960x540dp; 48dp/27dp is the 5% overscan-safe margin. -->
    <dimen name="tv_overscan_h">48dp</dimen>
    <dimen name="tv_overscan_v">27dp</dimen>
    <dimen name="tv_rail_width">80dp</dimen>
    <dimen name="tv_rail_width_open">232dp</dimen>
    <dimen name="tv_card_hero">288dp</dimen>
    <dimen name="tv_card">224dp</dimen>
    <dimen name="tv_card_gap">16dp</dimen>
    <dimen name="tv_dialog_width">600dp</dimen>

    <style name="Theme.FutoVideo.TV" parent="Theme.FutoVideo.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorPrimary</item>
    </style>

    <style name="TvText" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TvText.Display">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TvText.RowTitle">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TvText.CardTitle">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    <style name="TvText.Meta">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TvText.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="TvButton">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/tv_button_text</item>
        <item name="android:background">@drawable/tv_button</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
